# Copy to .env.local for a direct IntelliJ/Spring Boot run.
# Spring Boot imports this file from application.yml (root or module working directory).
# Run ./scripts/admin.sh once to generate var/admin.env with DB/admin secrets,
# or provide GW_ANALYTICS_DB_PASSWORD and GW_ADMIN_TOKEN here for an existing DB.
GW_BIND_ADDRESS=127.0.0.1
GW_PORT=8080
GW_ANALYTICS_ENABLED=true
GW_ANALYTICS_JDBC_URL=jdbc:postgresql://127.0.0.1:54329/llm_gateway
GW_ANALYTICS_DB_USER=llm_gateway
GW_ADMIN_UI_URL=http://localhost:3000/admin
GW_ACCESS_LOG_FILE=var/access.log
GW_ANALYTICS_ACCESS_LOG=var/access.log
GW_ANALYTICS_CONTENT_LOG=var/content.log
