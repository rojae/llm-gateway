# `npm run dev` starts only Next.js; scripts/dev.mjs reads .env.local.
# The API at this URL must have analytics enabled for admin login to work.
# `npm run dev:stack` starts PostgreSQL, the API, and Next.js together; its
# launcher passes the API URL as an environment variable instead.
GATEWAY_API_URL=http://127.0.0.1:8080

# Never put GW_ADMIN_TOKEN, provider API keys, DB passwords, or collector tokens
# in the Next.js environment. The browser asks for the local admin token at
# sign-in; the Spring Boot launcher keeps the actual value in ../var/admin.env.
# For an enterprise image, set GATEWAY_API_URL when building the image because
# Next.js embeds the rewrite destination in its production build.
